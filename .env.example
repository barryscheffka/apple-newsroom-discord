# Option A: bot of your Discord application (Developer Portal -> Bot -> Token).
# The bot needs "View Channel" and "Send Messages" in the target channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Option B: webhook (only used if no bot token is set)
DISCORD_WEBHOOK_URL=

# Feed (default: English). German: https://www.apple.com/de/newsroom/rss-feed.rss
FEED_URL=https://www.apple.com/newsroom/rss-feed.rss

# File that remembers which articles were already posted
STATE_FILE=data/seen.json

# Polling interval in seconds (loop mode only)
POLL_INTERVAL=600

# How many of the newest articles to post on the very first run
INITIAL_POST_COUNT=1

# Optional: avatar URL for the webhook sender (no effect in bot mode)
# AVATAR_URL=

# Optional: button label (default: "Read article", "Artikel lesen" for the German feed)
# BUTTON_LABEL=
