# Variante A: Bot der Discord-App (Developer Portal -> Bot -> Token).
# Der Bot braucht im Channel die Rechte "Kanal ansehen" und "Nachrichten senden".
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Variante B: Webhook (wird nur genutzt, wenn kein Bot-Token gesetzt ist)
DISCORD_WEBHOOK_URL=

# Feed (Standard: englisch). Deutsch: https://www.apple.com/de/newsroom/rss-feed.rss
FEED_URL=https://www.apple.com/newsroom/rss-feed.rss

# Pfad zur Datei mit den bereits geposteten Artikeln
STATE_FILE=data/seen.json

# Abfrageintervall in Sekunden (nur im Loop-Modus)
POLL_INTERVAL=600

# Wie viele der neuesten Artikel beim allerersten Start gepostet werden
INITIAL_POST_COUNT=1

# Optional: Avatar-URL für den Webhook-Absender (im Bot-Modus ohne Wirkung)
# AVATAR_URL=
